import numpy as np
def predict_instruments(audio_path, model, mlb):
    features = extract_features(audio_path)
    features = features.reshape(1, -1)

    # Get probabilities for all classes
    probs = model.predict_proba(features)[0]

    # Get the most likely instrument and its confidence
    max_prob_idx = np.argmax(probs)
    predicted_instrument = mlb.classes_[max_prob_idx]
    confidence = probs[max_prob_idx]
    return predicted_instrument, float(confidence)
