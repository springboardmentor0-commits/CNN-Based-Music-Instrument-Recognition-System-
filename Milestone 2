import os
import librosa
import numpy as np
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import LabelEncoder
from sklearn.metrics import classification_report
from sklearn.ensemble import RandomForestClassifier

audio_path = "/content/drive/MyDrive/nsynth-test/nsynth-test/audio"

files = os.listdir(audio_path)
def extract_features(file_path):
    y, sr = librosa.load(file_path, sr=22050, duration=2.5)
    mel = librosa.feature.melspectrogram(y=y, sr=sr, n_mels=64)
    mel_db = librosa.power_to_db(mel, ref=np.max)
    return np.mean(mel_db, axis=1)  # fixed-length feature
X = []
y = []

for f in files:
    if f.endswith(".wav"):
        instrument = f.split("_")[0]   # label
        path = os.path.join(audio_path, f)

        features = extract_features(path)
        X.append(features)
        y.append(instrument)

X = np.array(X)
y = np.array(y)

print(X.shape, y.shape)
le = LabelEncoder()
y_encoded = le.fit_transform(y)
X_train, X_test, y_train, y_test = train_test_split(
    X, y_encoded, test_size=0.2, random_state=42, stratify=y_encoded
)
model = RandomForestClassifier(n_estimators=100, random_state=42)
model.fit(X_train, y_train)
y_pred = model.predict(X_test)
report = classification_report(
    y_test,
    y_pred,
    target_names=le.classes_
)
print(report)

