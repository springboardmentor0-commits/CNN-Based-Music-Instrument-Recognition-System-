import os # Import os for file operations
import numpy as np
import librosa # Import librosa for audio feature extraction
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import LabelEncoder

# Define the audio path
audio_path = "/content/drive/MyDrive/nsynth-test/nsynth-test/audio"

# Define the feature extraction function
def extract_features(file_path):
    y_audio, sr = librosa.load(file_path, sr=22050, duration=2.5)
    mel = librosa.feature.melspectrogram(y=y_audio, sr=sr, n_mels=64)
    mel_db = librosa.power_to_db(mel, ref=np.max)
    return np.mean(mel_db, axis=1)

# Get the list of files. 'audio_path' is assumed to be defined from a previous cell.
files = os.listdir(audio_path)

# Extract features and populate X and y
X = []
y = []

for f in files:
    if f.endswith(".wav"):
        instrument = f.split("_")[0]   # label
        path = os.path.join(audio_path, f)

        features = extract_features(path)
        X.append(features)
        y.append(instrument)

# Convert lists to numpy arrays
X = np.array(X)
y = np.array(y)

# Encode labels
le = LabelEncoder()
y_encoded = le.fit_transform(y)

# Split dataset
X_train, X_test, y_train, y_test = train_test_split(
    X, y_encoded, test_size=0.2, random_state=42, stratify=y_encoded
)

# Print counts
print("Training samples count:", X_train.shape[0])
print("Testing samples count:", X_test.shape[0])

